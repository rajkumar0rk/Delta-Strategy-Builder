{
  "schema_version": 15,
  "app": "BTC Strategy Lab",
  "strategy": {
    "name": "BTCUSD 1H RSI2 + SMA200/EMA20 | RSI70/30 OR EMA20 exit | SL500",
    "market_type": "FUTURES",
    "timeframe": "1h",
    "direction_mode": "BOTH",
    "position_policy": "EXCLUSIVE",
    "conflict_policy": "SKIP",
    "call_action": "BUY",
    "put_action": "BUY",
    "call_signal_mode": "ORDER_ONLY",
    "put_signal_mode": "ORDER_ONLY",
    "futures": {
      "symbol": "BTCUSD",
      "contract_btc": 0.001,
      "quantity_lots": 1,
      "leverage": 5,
      "margin_mode": "ISOLATED",
      "maintenance_margin_percent": 0.25,
      "taker_fee_percent": 0.05,
      "gst_percent": 18,
      "slippage_bps": 2,
      "tick_size": 0.5,
      "slippage_ticks": 0,
      "funding_rate_multiplier": 1,
      "stop_loss_percent": null,
      "take_profit_percent": null,
      "funding_mode": "EXCLUDE_WITH_WARNING",
      "margin_tier_mode": "FLAT_RESEARCH",
      "pullback": {
        "enabled": false
      },
      "adaptive": {
        "enabled": false
      },
      "rule_risk": {
        "enabled": true,
        "stop_mode": "FIXED_POINTS",
        "stop_loss_points": 500,
        "stop_buffer_atr": 0,
        "atr_indicator_id": "atr14_5m",
        "stop_atr_multiple": 1.5,
        "swing_lookback_bars": 3,
        "atr_stop_anchor": "SIGNAL_CLOSE",
        "reward_r_multiple": null,
        "take_profit_points": null,
        "trailing_enabled": false,
        "trailing_mode": "POINTS",
        "trailing_atr_multiple": 3,
        "trailing_activation_points": 500,
        "trailing_pullback_points": 100,
        "trailing_source": "HIGH_LOW",
        "size_mode": "RISK_EQUITY",
        "equity_risk_percent": 0.5,
        "max_lots": 100000,
        "max_estimated_risk_multiple": 1
      },
      "candle_pattern": {
        "enabled": false
      }
    },
    "indicators": [
      {
        "id": "rsi2",
        "kind": "RSI",
        "params": {
          "period": 2
        },
        "timeframe": "strategy",
        "chart_only": false,
        "visible": true
      },
      {
        "id": "sma200",
        "kind": "SMA",
        "params": {
          "period": 200,
          "source": "close"
        },
        "timeframe": "strategy",
        "chart_only": false,
        "visible": true
      },
      {
        "id": "ema20",
        "kind": "EMA",
        "params": {
          "period": 20,
          "source": "close"
        },
        "timeframe": "strategy",
        "chart_only": false,
        "visible": true
      }
    ],
    "call_entry": {
      "mode": "ALL",
      "conditions": [
        {
          "id": "long_rsi_below3",
          "left": "rsi2",
          "operator": "LT",
          "value": 3
        },
        {
          "id": "long_sma",
          "left": "close",
          "operator": "GT",
          "right": "sma200"
        },
        {
          "id": "long_above_ema20",
          "left": "close",
          "operator": "GT",
          "right": "ema20"
        }
      ]
    },
    "put_entry": {
      "mode": "ALL",
      "conditions": [
        {
          "id": "short_rsi_above97",
          "left": "rsi2",
          "operator": "GT",
          "value": 97
        },
        {
          "id": "short_sma",
          "left": "close",
          "operator": "LT",
          "right": "sma200"
        },
        {
          "id": "short_below_ema20",
          "left": "close",
          "operator": "LT",
          "right": "ema20"
        }
      ]
    },
    "risk": {
      "starting_balance_usd": 1000,
      "max_hold_minutes": null,
      "max_trades_per_day": null,
      "max_consecutive_losses": null,
      "max_daily_loss_percent": null,
      "stop_trading_after_daily_loss_limit": true
    },
    "session": {
      "timezone": "Asia/Kolkata",
      "start": "00:00",
      "end": "23:59",
      "windows": [
        {
          "start": "00:00",
          "end": "23:59"
        }
      ],
      "blocked_weekdays": []
    },
    "call_exit": {
      "mode": "ANY",
      "min_pass": 1,
      "conditions": [
        {
          "id": "long_exit_rsi_recovery",
          "left": "rsi2",
          "operator": "GTE",
          "value": 70
        },
        {
          "id": "long_exit_ema20_invalidation",
          "left": "close",
          "operator": "LT",
          "right": "ema20"
        }
      ],
      "groups": []
    },
    "put_exit": {
      "mode": "ANY",
      "min_pass": 1,
      "conditions": [
        {
          "id": "short_exit_rsi_recovery",
          "left": "rsi2",
          "operator": "LTE",
          "value": 30
        },
        {
          "id": "short_exit_ema20_invalidation",
          "left": "close",
          "operator": "GT",
          "right": "ema20"
        }
      ],
      "groups": []
    },
    "call_entry_lifecycles": [
      {
        "id": "long_repeat",
        "name": "LONG RSI persists",
        "enabled": true,
        "trigger_condition_id": null,
        "delay_bars": 0,
        "max_wait_bars": null,
        "max_entries_per_activation": null,
        "cooldown_bars": 0
      }
    ],
    "put_entry_lifecycles": [
      {
        "id": "short_repeat",
        "name": "SHORT RSI persists",
        "enabled": true,
        "trigger_condition_id": null,
        "delay_bars": 0,
        "max_wait_bars": null,
        "max_entries_per_activation": null,
        "cooldown_bars": 0
      }
    ]
  }
}
